{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],
  "permission": {
    "external_directory": {
      "~/go/pkg/**": "allow",
      "~/.crit/reviews/**": "allow"
    },
    "edit": {
      "~/go/pkg/**": "deny"
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
